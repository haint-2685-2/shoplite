{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode: Vite compiles, tsc only type-checks */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Same strictness as v3-ts, so every error shown in a lab is one the
       real project would raise too. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* Two deliberate differences from v3-ts:
       - erasableSyntaxOnly is off so lab 1.2 can show a real `enum`
         (enums generate runtime code, which that flag forbids).
       - unused locals/parameters are allowed: labs declare values just to
         hover over them and read the inferred type. */
    "erasableSyntaxOnly": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "scripts"]
}
